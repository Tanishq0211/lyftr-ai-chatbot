# Backend. Replace both placeholders with distinct provider keys.
LLM_API_KEYS=replace-with-first-key,replace-with-second-key
LLM_MODEL=gemini/gemini-3.5-flash-lite
# Optional: assign one model per key in the same order as LLM_API_KEYS.
LLM_MODELS=
# Optional alternative provider URL. Leave blank for the model's default provider.
LLM_API_BASE=
DATABASE_URL=sqlite:////data/app.db
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
ENABLE_FAILURE_SIMULATION=true
# Optional backend listen port. Railway injects this automatically.
PORT=8000
# Frontend. This public URL is embedded at build time.
VITE_API_BASE_URL=http://localhost:8000
